# =============================================================================
# DevOps Dashboard Platform — Environment Variables
# =============================================================================
# Copy to .env and edit:  cp .env.example .env
# All values below are safe defaults for local development.
# =============================================================================

# ---- PostgreSQL ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=devops
DB_PASSWORD=devops
DB_NAME=devops_dashboard
DATABASE_URL=jdbc:postgresql://localhost:5432/devops_dashboard

# ---- Service Ports ----
FRONTEND_PORT=3000
API_PORT=4000
AUTH_PORT=4001
DEPLOYMENT_PORT=4002
NOTIFICATION_PORT=4003
WORKER_PORT=4004

# ---- JWT ----
JWT_SECRET=change-me-in-production-must-be-at-least-32-chars
JWT_EXPIRATION_MS=86400000

# ---- Worker ----
POLL_INTERVAL_MS=30000
WORKER_STALE_TIMEOUT_MINS=30
WORKER_SYNC_INTERVAL_MS=60000

# ---- Notification Channels ----
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_FROM=noreply@devops-dashboard.local
NOTIFICATION_SMTP_HOST=localhost
NOTIFICATION_SMTP_PORT=587

NOTIFICATION_SLACK_ENABLED=false
NOTIFICATION_SLACK_WEBHOOK=

# ---- Logging ----
LOG_LEVEL=info
